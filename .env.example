OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CPU_ONLY=false
OLLAMA_NUM_CTX=8192
DOCS_DIR=docs
DB_DIR=./db
CHAT_DB_PATH=./chats.sqlite3
RRF_K=60
HYBRID_CANDIDATES=12
RERANK_ENABLED=false
BILINGUAL_QUERY=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MAX_UPLOAD_SIZE=20971520
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# OCR runs locally only for PDF pages with little or no embedded text.
OCR_ENABLED=false
OCR_LANG=ara+eng
OCR_MIN_TEXT_CHARS=40
# On Windows, point these at the local installation and downloaded language data.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSDATA_DIR=./ocr/tessdata
